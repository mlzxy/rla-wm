<?xml version="1.0" ?>
<robot name="ur10e">

  <material name="Black">
    <color rgba="0.033 0.033 0.033 1.0"/>
  </material>
  <material name="JointGray">
    <color rgba="0.278 0.278 0.278 1.0"/>
  </material>
  <material name="LinkGray">
    <color rgba="0.82 0.82 0.82 1.0"/>
  </material>
  <material name="URBlue">
    <color rgba="0.49 0.678 0.8 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="assets/base_0.obj"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/base_1.obj"/>
      </geometry>
      <material name="JointGray"/>
    </visual>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00610633" ixy="0" ixz="0" iyy="0.00610633" iyz="0" izz="0.01125"/>
    </inertial>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.181" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" effort="330" velocity="3.14"/>
    <dynamics damping="10" friction="0"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry>
        <mesh filename="assets/shoulder_0.obj"/>
      </geometry>
      <material name="URBlue"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/shoulder_1.obj"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/shoulder_2.obj"/>
      </geometry>
      <material name="JointGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.078" length="0.16"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.778"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0314743" ixy="0" ixz="0" iyy="0.0314743" iyz="0" izz="0.0218756"/>
    </inertial>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.176 0" rpy="0 1.5707963 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="330" velocity="3.14"/>
    <dynamics damping="10" friction="0"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <geometry>
        <mesh filename="assets/upperarm_0.obj"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/upperarm_1.obj"/>
      </geometry>
      <material name="JointGray"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/upperarm_2.obj"/>
      </geometry>
      <material name="URBlue"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/upperarm_3.obj"/>
      </geometry>
      <material name="LinkGray"/>
    </visual>
    <collision>
      <origin xyz="0 -0.05 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.078" length="0.16"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.6"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="12.93"/>
      <origin xyz="0 0 0.3065" rpy="0 0 0"/>
      <inertia ixx="0.423074" ixy="0" ixz="0" iyy="0.423074" iyz="0" izz="0.0363656"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.137 0.613" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1415" upper="3.1415" effort="150" velocity="3.14"/>
    <dynamics damping="5" friction="0"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry>
        <mesh filename="assets/forearm_0.obj"/>
      </geometry>
      <material name="URBlue"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/forearm_1.obj"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/forearm_2.obj"/>
      </geometry>
      <material name="JointGray"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/forearm_3.obj"/>
      </geometry>
      <material name="LinkGray"/>
    </visual>
    <collision>
      <origin xyz="0 0.08 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.058" length="0.13"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0.29" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.043" length="0.56"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.87"/>
      <origin xyz="0 0 0.2855" rpy="0 0 0"/>
      <inertia ixx="0.11059" ixy="0" ixz="0" iyy="0.11059" iyz="0" izz="0.0108844"/>
    </inertial>
  </link>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.571" rpy="0 1.5707963 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="56" velocity="3.14"/>
    <dynamics damping="2" friction="0"/>
  </joint>

  <link name="wrist_1_link">
    <visual>
      <geometry>
        <mesh filename="assets/wrist1_0.obj"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/wrist1_1.obj"/>
      </geometry>
      <material name="URBlue"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/wrist1_2.obj"/>
      </geometry>
      <material name="JointGray"/>
    </visual>
    <collision>
      <origin xyz="0 0.06 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.96"/>
      <origin xyz="0 0.135 0" rpy="0 0 0"/>
      <inertia ixx="0.0055125" ixy="0" ixz="0" iyy="0.00510825" iyz="0" izz="0.00510825"/>
    </inertial>
  </link>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.135 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" effort="56" velocity="3.14"/>
    <dynamics damping="2" friction="0"/>
  </joint>

  <link name="wrist_2_link">
    <visual>
      <geometry>
        <mesh filename="assets/wrist2_0.obj"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/wrist2_1.obj"/>
      </geometry>
      <material name="URBlue"/>
    </visual>
    <visual>
      <geometry>
        <mesh filename="assets/wrist2_2.obj"/>
      </geometry>
      <material name="JointGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.046" length="0.13"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0.028 0.12" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.046" length="0.086"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.96"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <inertia ixx="0.0055125" ixy="0" ixz="0" iyy="0.00510825" iyz="0" izz="0.00510825"/>
    </inertial>
  </link>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="56" velocity="3.14"/>
    <dynamics damping="2" friction="0"/>
  </joint>

  <link name="wrist_3_link">
    <visual>
      <geometry>
        <mesh filename="assets/wrist3.obj"/>
      </geometry>
      <material name="LinkGray"/>
    </visual>
    <collision>
      <origin xyz="0 0.097 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.046" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0.092 0" rpy="1.5707963 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="attachment_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="attachment_link"/>
    <origin xyz="0 0.1 0" rpy="-1.5707963 0 0"/>
  </joint>
  
  <link name="attachment_link">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Stick attachment -->
  <joint name="stick_joint" type="fixed">
    <parent link="attachment_link"/>
    <child link="stick_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="stick_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.1"/>
      </geometry>
      <material name="LinkGray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- TCP at the end of the stick -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="stick_link"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
</robot>
